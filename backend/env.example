# NidhiGuard backend configuration (Stage 6.6).
# Copy to backend/.env (git-ignored) and fill in. Real environment variables
# take precedence over this file. NEVER commit the real .env.

# Secret used to sign login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset, a random per-process secret is generated: safe, but every
# login stops working whenever the server restarts.
NIDHIGUARD_AUTH_SECRET=

# Access-token lifetime in minutes (default 480 = 8 hours).
NIDHIGUARD_AUTH_TOKEN_MINUTES=480

# Optional overrides for the DEVELOPMENT/DEMO accounts created by
#   python -m backend.app.auth.seed
# NIDHIGUARD_DEMO_ADMIN_PASSWORD=
# NIDHIGUARD_DEMO_INVESTIGATOR_PASSWORD=
# NIDHIGUARD_DEMO_VIEWER_PASSWORD=
